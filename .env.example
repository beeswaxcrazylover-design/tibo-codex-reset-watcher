# X Developer Console 中应用的 Bearer Token（不要加引号也可以）
X_BEARER_TOKEN=

# Tibo / Thibault Sottiaux
X_USERNAME=thsottiaux

# SMTP 配置。SSL 常用 465；STARTTLS 常用 587。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
SMTP_USE_SSL=true
SMTP_STARTTLS=false

# 每 5 分钟检查一次；X API 按使用量计费，可按需调大。
POLL_INTERVAL_SECONDS=300

# 第一次运行会检查过去 24 小时，之后只检查新帖。
FIRST_RUN_LOOKBACK_HOURS=24
STATE_FILE=.state/tibo-reset-watcher.json

# 可选：逗号分隔，自定义匹配词。需要两组各命中至少一个才发信。
# PRODUCT_KEYWORDS=codex,chatgpt work
# RESET_KEYWORDS=reset,usage limit,usage limits,rate limit,rate limits,weekly limit,weekly limits,hourly limit,hourly limits,quota,banked reset,reset bank,100% weekly,100% hourly
